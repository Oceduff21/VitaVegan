generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String    @default("")
  name             String
  firstName        String    @default("")
  lastName         String    @default("")
  birthDate        String    @default("")
  /** Public nickname shown on posts & comments (@handle). */
  handle           String?   @unique
  prefs            String    @default("{}")
  role             String    @default("member")
  stripeCustomerId String?
  stripeSubId      String?
  subStatus        String?
  scansToday       Int       @default(0)
  scansDate        String?
  /** Plant-based points earned by cooking / missions; spent in the leaf shop. */
  leafPoints       Int       @default(0)
  trialEndsAt      DateTime?
  createdAt        DateTime  @default(now())
  recipes          Recipe[]
  foodLogs         FoodLog[]
  favorites        Favorite[]
  recipeReviews    RecipeReview[]
  quizResults      QuizResult[]
  scanEvents       ScanEvent[]
  productFavs      ProductFav[]
  shoppingItems    ShoppingItem[]
  reports          Report[]
  leafSpends       LeafSpend[]
  notifications    Notification[]
  dailyMissions    DailyMission[]
  weekMealSlots    WeekMealSlot[]
  contributions    ProductContribution[]
  friendshipsOut   Friendship[]  @relation("FriendshipFrom")
  friendshipsIn    Friendship[]  @relation("FriendshipTo")
  sharesSent       RecipeShare[] @relation("ShareFrom")
  sharesReceived   RecipeShare[] @relation("ShareTo")
}

model Recipe {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  source      String
  status      String
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  summary     String
  category    String
  timeMinutes Int
  difficulty  String
  servings    Int
  ingredients String
  steps       String
  nutrients   String
  imageHint   String
  image       String     @default("")
  veganScore  Int        @default(5)
  veganWhy    String
  glutenFree  Boolean    @default(false)
  rejectReason String?
  gear         String    @default("[]")
  tasting      String    @default("{}")
  createdAt    DateTime  @default(now())
  favorites    Favorite[]
  reviews      RecipeReview[]
}

model RecipeReview {
  id            String   @id @default(cuid())
  recipeId      String
  recipe        Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String   @default("")
  /** Optional cook photo (data URL or path). */
  photo         String   @default("")
  /** Local YYYY-MM-DD of last leaf-point award for cooking this recipe. */
  leafAwardedOn String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([recipeId, userId])
}

model FoodLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String
  kind       String
  label      String
  barcode    String?
  nutrients  String
  veganScore Int
  veganWhy   String
  createdAt  DateTime @default(now())
}

model Favorite {
  userId   String
  recipeId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CatalogProduct {
  id               String   @id @default(cuid())
  kind             String   @default("food")
  barcode          String   @default("")
  name             String
  brand            String   @default("")
  image            String   @default("")
  ingredientsText  String   @default("")
  veganScore       Int      @default(3)
  veganWhy         String   @default("")
  cruelty          String   @default("unknown")
  /** user-scan | user-created | openfoodfacts | openbeautyfacts */
  source           String   @default("user-scan")
  scanCount        Int      @default(1)
  authorId         String?
  createdAt        DateTime @default(now())
}

model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  score     Int
  total     Int
  createdAt DateTime @default(now())
}

model ScanEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String   @default("food")
  barcode    String   @default("")
  name       String
  brand      String   @default("")
  image      String   @default("")
  veganScore Int      @default(3)
  veganWhy   String   @default("")
  cruelty    String   @default("")
  ecoGrade   String   @default("")
  palmOil    String   @default("unknown")
  origin     String   @default("")
  createdAt  DateTime @default(now())
}

model ProductFav {
  userId     String
  kind       String
  barcode    String
  name       String   @default("")
  image      String   @default("")
  veganScore Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, barcode])
}

model ShoppingItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  recipeSlug String   @default("")
  barcode    String   @default("")
  kind       String   @default("")
  source     String   @default("manual")
  inFridge   Boolean  @default(false)
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Report {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String
  barcode   String   @default("")
  target    String   @default("")
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model LeafSpend {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku       String
  cost      Int
  qty       Int      @default(1)
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, sku])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String   @default("")
  href      String   @default("")
  payload   String   @default("{}")
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model DailyMission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  code      String
  progress  Int      @default(0)
  target    Int      @default(1)
  reward    Int      @default(5)
  claimedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, date, code])
}

model WeekMealSlot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart  String
  dayIndex   Int
  slot       String
  recipeSlug String   @default("")
  label      String   @default("")
  barcode    String   @default("")
  createdAt  DateTime @default(now())

  @@unique([userId, weekStart, dayIndex, slot])
}

model ProductContribution {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  barcode         String   @default("")
  kind            String   @default("food")
  name            String
  brand           String   @default("")
  ingredientsText String   @default("")
  image           String   @default("")
  status          String   @default("pending")
  catalogId       String?
  createdAt       DateTime @default(now())
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  peerId    String
  from      User     @relation("FriendshipFrom", fields: [userId], references: [id], onDelete: Cascade)
  to        User     @relation("FriendshipTo", fields: [peerId], references: [id], onDelete: Cascade)
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([userId, peerId])
  @@index([peerId, status])
}

model RecipeShare {
  id         String   @id @default(cuid())
  recipeSlug String
  fromId     String
  toId       String?
  from       User     @relation("ShareFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to         User?    @relation("ShareTo", fields: [toId], references: [id], onDelete: Cascade)
  message    String   @default("")
  token      String?  @unique
  createdAt  DateTime @default(now())

  @@index([toId, createdAt])
}
